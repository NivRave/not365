# PostgreSQL
POSTGRES_USER=not365
POSTGRES_PASSWORD=not365
POSTGRES_DB=not365
POSTGRES_PORT=5435
POSTGRES_DSN=postgres://not365:not365@localhost:5435/not365?sslmode=disable

# MongoDB (replica set rs0 required for transactions)
MONGO_PORT=27017
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=not365

# Redis
REDIS_PORT=6380
REDIS_ADDR=localhost:6380

# Server Ports
API_PORT=8088
GATEWAY_PORT=8089

# Auth
# AUTH_MODE: "stub" for local dev without OAuth credentials, "oauth" for real Google/Apple OAuth
AUTH_MODE=stub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
JWT_SECRET=dev-jwt-secret-not365-change-in-production-32chars

# VAPID Push (generate with: go run ./cmd/vapid-keygen)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@not365.app
